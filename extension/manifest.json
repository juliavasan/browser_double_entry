{
  "manifest_version": 3,
  "name": "Bulk Entry",
  "version": "0.1.0",
  "description": "Example: enter many records from a JSON file into a web app's forms, using your normal browser session.",
  "action": {
    "default_title": "Bulk Entry"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*"
  ]
}
